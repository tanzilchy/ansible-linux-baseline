# {{ ansible_managed }}
minlen = {{ linux_password_policy_minlen }}
# A negative credit means "at least this many characters of the class are required".
lcredit = {{ -1 if linux_password_policy_require_lower else 0 }}
ucredit = {{ -1 if linux_password_policy_require_upper else 0 }}
dcredit = {{ -1 if linux_password_policy_require_digit else 0 }}
ocredit = {{ -1 if linux_password_policy_require_special else 0 }}
usercheck = {{ 1 if linux_password_policy_reject_username else 0 }}
retry = 3
{% if linux_password_policy_enforce_for_root %}
enforce_for_root
{% endif %}